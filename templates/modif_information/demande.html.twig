{% extends 'baseEmp.html.twig' %}

{% block title %}Information{% endblock %}

{% block body %}
<style>
#page{
         margin-top:80px; 
      }
      #titre{     
         margin-bottom:40px;
               font-weight: bold;
          color:#FF8C00;
          text-decoration: underline ;
           font-family: Times ;
      }
</style>
<center>
<div class="col-lg-6 mb-5 mb-lg-0 position-relative" id="page">
        <div id="radius-shape-1" class="position-absolute rounded-circle shadow-5-strong"></div>
        <div id="radius-shape-2" class="position-absolute shadow-5-strong"></div>

        <div class="card bg-glass">
          <div class="card-body px-4 py-5 px-md-5">
            <h1 id="titre"> Modification d'information personnel</h1>
          {{ form_start(for) }}
            <div  class="form-outline mb-4">
                  {{ form_row(for.TypeModification, { 'attr': {'class': ' form-control form-control-lg'}}) }}
              </div>
              <div class="form-outline mb-4">
                   {{ form_row(for.libelle,{'attr': {'class': ' form-control form-control-lg'}}) }}
              </div>
               <button type="submit" class="btn btn-warning btn-block mb-4" >
               ajouter
              </button>
              {{ form_end(for) }}
            
          </div>
        </div>
      </div>
    </div>
</center>

{% endblock %}

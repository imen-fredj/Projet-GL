{% extends 'baseadmin.html.twig' %}

{% block title %}Demandes d'activation{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white">
                <h3 class="text-center font-weight-light my-2">Demandes d'activation de compte</h3>
            </div>
            <div class="card-body">
                {% for message in app.flashes('notice') %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        <p class="mb-0">{{ message | raw }}</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}

                {# Barre de recherche #}
                <form method="POST" class="mb-4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="fas fa-id-card"></i></span>
                               <input type="text" class="form-control" name="cin" placeholder="Recherche par CIN" value="{{ app.request.query.get('cin') }}">
                            </div>
                        </div>
                       
                </form>

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle" id="demandeTable">
                        <thead class="table-light">
                            <tr>
                                <th>Photo</th>
                                <th>CIN</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Email</th>
                                <th>Adresse</th>
                                <th>Téléphone</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for Rh in personne %}
                                {% for role in Rh.roles %}
                                    {% if role == "ROLE_Rh" %}
                                    <tr>
                                        <td>
                                            <img src="{{ asset('pic/' ~ Rh.image) }}" 
                                                 class="rounded-circle shadow-sm"
                                                 alt="Photo profil"
                                                 style="width: 40px; height: 40px; object-fit: cover">
                                        </td>
                                        <td>{{ Rh.cin }}</td>
                                        <td>{{ Rh.nom }}</td>
                                        <td>{{ Rh.prenom }}</td>
                                        <td>{{ Rh.email }}</td>
                                        <td>{{ Rh.adresse }}</td>
                                        <td>{{ Rh.telephone }}</td>
                                        <td class="text-center">
                                            <a href="{{ path('accepter', {'id': Rh.id}) }}" 
                                               class="btn btn-sm btn-success me-2"
                                               title="Activer le compte">
                                                <i class="fas fa-check me-1"></i>Activer
                                            </a>
                                            <a href="{{ path('refuser', {'id': Rh.id}) }}" 
                                               class="btn btn-sm btn-danger"
                                               title="Refuser l'activation">
                                                <i class="fas fa-times me-1"></i>Refuser
                                            </a>
                                        </td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="8" class="text-center">Aucune demande d'activation trouvée</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <div class="small">
                    <i class="fas fa-info-circle me-1"></i>
                    Gestion des demandes d'activation des comptes RH
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table {
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 8px;
        overflow: hidden;
    }
    
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
        text-align: center;
    }
    
    .btn-success {
        transition: all 0.3s;
    }
    
    .btn-danger {
        transition: all 0.3s;
    }
    
    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }
    
    .btn-danger:hover {
        background-color: #c82333;
        border-color: #bd2130;
    }
    
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }
    
    .card-footer {
        border-radius: 0 0 10px 10px !important;
    }
    
    .table td {
        vertical-align: middle;
    }
    
    .input-group-text {
        min-width: 40px;
        justify-content: center;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.querySelector('input[name="cin"]');
    
    searchInput.addEventListener('input', function() {
        const searchValue = this.value.toLowerCase();
        const rows = document.querySelectorAll('#demandeTable tbody tr');
        
        rows.forEach(row => {
            const cin = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
            if (cin.includes(searchValue)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
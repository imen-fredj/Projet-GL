{% extends 'baserh.html.twig' %}

{% block title %}Demande d'activation de compte{% endblock %}

{% block body %}
{% if is_granted('ROLE_Rh') %}
<style>
    .page-title {
        margin-bottom: 30px;
        font-weight: bold;
        color: #ff8c00;
        font-family: Times;
        border-bottom: 2px solid #ff8c00;
        padding-bottom: 10px;
        display: inline-block;
    }

    .search-bar {
        margin-bottom: 30px;
    }

    .table-container {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .btn-action a {
        text-decoration: none;
        color: inherit;
    }

    .btn-action:hover {
        transform: scale(1.05);
        transition: all 0.2s;
    }

    .alert-danger {
        margin-bottom: 20px;
    }

    .form-inline .form-control {
        margin-right: 10px;
    }
</style>

<div class="container mt-5">
    <h2 class="page-title">Demandes d'activation de compte</h2>

    <div class="search-bar">
        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par CIN..." />
    </div>

    {% for message in app.flashes('notice') %}
        <div class="alert alert-danger">{{ message|raw }}</div>
    {% endfor %}

    <div class="card table-container">
        <table class="table table-striped table-hover align-middle" id="myTable">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>CIN</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Adresse</th>
                    <th>Téléphone</th>
                    <th>Activer</th>
                    <th>Refuser</th>
                </tr>
            </thead>
            <tbody>
                {% for Rh in personne %}
                    {% if 'ROLE_USERS' in Rh.roles %}
                        <tr>
                            <td><img src="{{ asset('pic/' ~ Rh.image) }}" class="rounded-circle" alt="Photo" width="40" height="40"></td>
                            <td>{{ Rh.cin }}</td>
                            <td>{{ Rh.nom }}</td>
                            <td>{{ Rh.prenom }}</td>
                            <td>{{ Rh.email }}</td>
                            <td>{{ Rh.adresse }}</td>
                            <td>{{ Rh.telephone }}</td>
                            <td>
                                <a href="{{ path('accepter', {'id': Rh.id}) }}" class="btn btn-outline-success btn-sm btn-action">
                                    <i class="fas fa-check-circle me-1"></i>Activer
                                </a>
                            </td>
                            <td>
                                <a href="{{ path('refuser', {'id': Rh.id}) }}" class="btn btn-outline-danger btn-sm btn-action">
                                    <i class="fas fa-times-circle me-1"></i>Refuser
                                </a>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        const tableRows = document.querySelectorAll('#myTable tbody tr');

        searchInput.addEventListener('keyup', function() {
            const searchValue = searchInput.value.toLowerCase();

            tableRows.forEach(row => {
                const cinCell = row.cells[1]; // CIN est dans la deuxième colonne
                const cinText = cinCell ? cinCell.textContent.toLowerCase() : '';

                // Afficher ou masquer la ligne en fonction de la correspondance
                if (cinText.includes(searchValue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>

{% endif %}
{% endblock %}

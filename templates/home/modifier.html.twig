{% extends 'baserh.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
#page{     
         margin-top:40px;     
      }
            #btn:hover {
  background-color: gold;
            }
  #titre{     
         margin-bottom:40px;
               font-weight: bold;
          color:#FF8C00;
          text-decoration: underline ;
           font-family: Times ;
      }

</style>
<center>
<div class="col-lg-6 mb-5 mb-lg-0 position-relative" id="page">
        <div id="radius-shape-1" class="position-absolute rounded-circle shadow-5-strong"></div>
        <div id="radius-shape-2" class="position-absolute shadow-5-strong"></div>

        <div class="card bg-glass">
          <div class="card-body px-4 py-5 px-md-5">
          <h2 id="titre">Modifier les données personnelles d'un employé </h2>
        {{ form_start(for, {'attr': {'class': 'forms-sample'}}) }}
                  <form class="forms-sample">
                    <div class="form-group">
                     {{ form_row(for.nom, { 'attr': {'class': ' form-control form-control-lg'}}) }}
                    </div>
                    <div class="form-group">
                     {{ form_row(for.prenom, { 'attr': {'class': ' form-control form-control-lg'}}) }}
                    </div>
                    <div class="form-group">
                      {{ form_row(for.cin, { 'attr': {'class': ' form-control form-control-lg'}}) }}
                    </div>
                    
                    <div class="form-group">
                   
                     
                       {{ form_row(for.adresse, { 'attr': {'class': ' form-control form-control-lg'}}) }}
                        
                    </div>
                    <button  id="btn" type="submit"  class="btn btn-light">Modifier</button>
                  
                  </form>
                   {{ form_end(for) }}
                </div>
                </div>
                </div>
                </div>
                </div>
                </center>
               
             
 
{% endblock %}

{% extends 'baseadmin.html.twig' %}

{% block title %}Responsables RH{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white">
                <h3 class="text-center font-weight-light my-2">Liste des Responsables de Ressources Humaines</h3>
            </div>
            <div class="card-body">
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        <p class="mb-0">{{ message | raw }}</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}

                {# Barre de recherche #}
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                            <input type="text" id="globalSearch" class="form-control" placeholder="Recherche par nom ,prenom,email">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light"><i class="fas fa-id-card"></i></span>
                            <input type="text" id="cinSearch" class="form-control" placeholder="Recherche par CIN...">
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle" id="rhTable">
                        <thead class="table-light">
                            <tr>
                                <th>Photo</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Adresse</th>
                                <th>Email</th>
                                <th>CIN</th>
                                <th>Téléphone</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for Rh in personne %}
                                {% for role in Rh.roles %}
                                    {% if role == "ROLE_Rh" %}
                                    <tr class="rh-row">
                                        <td>
                                            <img src="{{ asset('pic/' ~ Rh.image) }}" 
                                                 class="rounded-circle shadow-sm"
                                                 alt="Photo profil"
                                                 style="width: 40px; height: 40px; object-fit: cover">
                                        </td>
                                        <td class="searchable">{{ Rh.nom }}</td>
                                        <td class="searchable">{{ Rh.prenom }}</td>
                                        <td>{{ Rh.adresse }}</td>
                                        <td>{{ Rh.email }}</td>
                                        <td class="cin-searchable">{{ Rh.cin }}</td>
                                        <td>{{ Rh.telephone }}</td>
                                        <td class="text-center">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deleteModal{{ Rh.id }}">
                                                <i class="fas fa-trash me-1"></i>Supprimer
                                            </button>
                                        </td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="8" class="text-center">Aucun responsable RH trouvé</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <div class="small">
                    <i class="fas fa-info-circle me-1"></i>
                    Gestion des responsables des ressources humaines de l'entreprise
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals de confirmation de suppression -->
{% for Rh in personne %}
    {% for role in Rh.roles %}
        {% if role == "ROLE_Rh" %}
        <div class="modal fade" id="deleteModal{{ Rh.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ Rh.id }}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="deleteModalLabel{{ Rh.id }}">Confirmer la suppression</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Êtes-vous sûr de vouloir supprimer le responsable RH "<strong>{{ Rh.nom }} {{ Rh.prenom }}</strong>" ?</p>
                        <p class="text-danger"><small>Cette action est irréversible !</small></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <a href="{{ path('app_supprime', {'id': Rh.id}) }}" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Supprimer
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    {% endfor %}
{% endfor %}

<style>
    .table {
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 8px;
        overflow: hidden;
    }
    
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
        text-align: center;
    }
    
    .btn-outline-danger {
        transition: all 0.3s;
    }
    
    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }
    
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }
    
    .card-footer {
        border-radius: 0 0 10px 10px !important;
    }
    
    .table td {
        vertical-align: middle;
    }
    
    .input-group-text {
        min-width: 40px;
        justify-content: center;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Recherche globale
    const globalSearch = document.getElementById('globalSearch');
    const cinSearch = document.getElementById('cinSearch');
    const rows = document.querySelectorAll('.rh-row');
    
    function filterRows() {
        const globalTerm = globalSearch.value.toLowerCase();
        const cinTerm = cinSearch.value.toLowerCase();
        
        rows.forEach(row => {
            const cells = row.querySelectorAll('.searchable');
            const cinCell = row.querySelector('.cin-searchable');
            let matchesGlobal = true;
            let matchesCin = true;
            
            // Filtre global
            if (globalTerm) {
                matchesGlobal = Array.from(cells).some(cell => 
                    cell.textContent.toLowerCase().includes(globalTerm)
                );
            }
            
            // Filtre CIN
            if (cinTerm) {
                matchesCin = cinCell.textContent.toLowerCase().includes(cinTerm);
            }
            
            // Afficher/masquer la ligne selon les filtres
            row.style.display = (matchesGlobal && matchesCin) ? '' : 'none';
        });
    }
    
    globalSearch.addEventListener('input', filterRows);
    cinSearch.addEventListener('input', filterRows);
});
</script>
{% endblock %}
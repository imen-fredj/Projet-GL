{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Notification</h4>
        </div>
        <div class="card-body">
            <p>{{ notification.text }}</p>
            <small class="text-muted">Reçue le {{ notification.date_notification|date('d/m/Y H:i') }}</small>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_homeresponsable') }}" class="btn btn-primary">
                Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
{% extends 'baserh.html.twig' %}


{% block title %}Liste des Avances{% endblock %}

{% block body %}
{% if is_granted('ROLE_Rh') %}
<style>
    .page-title {
        margin-bottom: 30px;
        font-weight: bold;
        color: #ff8c00;
        font-family: Times;
        border-bottom: 2px solid #ff8c00;
        padding-bottom: 10px;
        display: inline-block;
    }
    .table-container {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .table-hover tbody tr:hover {
        background-color: #f9f9f9;
    }
    .status-pending {
        color: #FFA500;
        font-weight: bold;
    }
    .status-approved {
        color: #28a745;
        font-weight: bold;
    }
    .status-rejected {
        color: #dc3545;
        font-weight: bold;
    }
    .btn-action:hover {
        transform: scale(1.05);
        transition: all 0.2s;
    }
</style>

<div class="container mt-5">
    <h2 class="page-title">Liste des Avances sur Salaire</h2>

    {% for message in app.flashes('notice') %}
        <div class="alert alert-danger">{{ message|raw }}</div>
    {% endfor %}

    <div class="card table-container">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>CIN</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Date demande</th>
                    <th>Montant</th>
                    <th>Date d'avance</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for Avance in avances %}
                    <tr>
                        <td><img src="{{ asset('pic/' ~ Avance.Rh.image) }}" class="rounded-circle" alt="Image" width="40" height="40"></td>
                        <td>{{ Avance.Rh.cin }}</td>
                        <td>{{ Avance.Rh.nom }}</td>
                        <td>{{ Avance.Rh.prenom }}</td>
                        <td>{{ Avance.dateDemande|date('d/m/Y') }}</td>
                        <td>{{ Avance.montant }} TND</td>
                        <td>{{ Avance.dateavance|date('d/m/Y') }}</td>
                        <td class="status-{{ Avance.etat|lower }}">{{ Avance.etat }}</td>
                        <td>
                            {% if Avance.etat == 'en cours' %}
                                <a href="{{ path('avance_accepte', {'id': Avance.id}) }}" class="btn btn-outline-success btn-sm me-2" title="Accepter">
                                    <i class="fas fa-check"></i>
                                </a>
                                <a href="{{ path('avance_refuse', {'id': Avance.id}) }}" class="btn btn-outline-danger btn-sm" title="Refuser">
                                    <i class="fas fa-times"></i>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>



{% endif %}
{% endblock %}

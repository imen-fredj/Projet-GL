{% extends 'baseEmp.html.twig' %}

{% block title %}Demande d'acompte{% endblock %}

{% block body %}
<style>
    .page-title {
        margin-bottom: 30px;
        font-weight: bold;
        color: #FF8C00;
        font-family: Times;
        border-bottom: 2px solid #FF8C00;
        padding-bottom: 10px;
        display: inline-block;
    }

    .btn-add {
        background-color: #F5F5DC;
        border: 1px solid #FF8C00;
        color: #333;
        margin-left: 20px;
        transition: all 0.3s;
    }

    .btn-add:hover {
        background-color: #FF8C00;
        color: white;
    }

    .table-container {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .table img {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 50%;
    }

    .status-pending {
        color: #FFA500;
        font-weight: bold;
    }

    .status-approved {
        color: #28a745;
        font-weight: bold;
    }

    .status-rejected {
        color: #dc3545;
        font-weight: bold;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        border-radius: 0.2rem;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }

    .btn-danger:hover {
        background-color: #c82333;
        border-color: #bd2130;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Demande d'acompte</h2>
        <a href="{{ path('app_avance') }}" class="btn btn-add">
            <i class="fas fa-plus me-2"></i>Ajouter une demande
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show m-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card table-container">
        <table class="table table-striped table-hover align-middle" id="myTable">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>CIN</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Date demande</th>
                    <th>Montant</th>
                    <th>Date d'avance</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for AvanceSalaire in salaire %}
                    <tr>
                        <td>
                            <img src="{{ asset('pic/' ~ AvanceSalaire.Rh.image) }}" alt="Photo employé">
                        </td>
                        <td>{{ AvanceSalaire.Rh.cin }}</td>
                        <td>{{ AvanceSalaire.Rh.nom }}</td>
                        <td>{{ AvanceSalaire.Rh.prenom }}</td>
                        <td>{{ AvanceSalaire.datedemande|date("d/m/Y") }}</td>
                        <td>{{ AvanceSalaire.montant }}</td>
                        <td>{{ AvanceSalaire.dateavance|date("d/m/Y") }}</td>
                        <td class="status-{{ AvanceSalaire.etat|lower }}">{{ AvanceSalaire.etat }}</td>
                        <td>
                            {# <a href="{{ path('app_supprimer', {'id': AvanceSalaire.id}) }}" class="btn btn-danger btn-sm me-2">
                                <i class="fas fa-trash"></i>
                            </a> #}
                            <a href="{{ path('app_modifavance', {'id': AvanceSalaire.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}

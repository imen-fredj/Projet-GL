{% extends 'baseEmp.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
  
<style>
#page{     
         margin-top:40px;     
      }
      #rech{     
         margin-bottom:40px;     
      }
       #recherch{     
        text-align: center; 
 
      }
      #titre{     
         margin-bottom:40px;
               font-weight: bold;
          color:#FF8C00;
          text-decoration: underline ;
           font-family: Times ;
      }
        #btn{     
        margin-left:90px;
        width:130px;
        background-color: 	#F5F5DC;
        
      }
</style>
 <center>
 <div class="col-lg-10 mb-5 mb-lg-0 position-relative" id="page">
        <div id="radius-shape-1" class="position-absolute rounded-circle shadow-5-strong"></div>
        <div id="radius-shape-2" class="position-absolute shadow-5-strong"></div>

        <div class="card bg-glass">
          <div class="card-body px-4 py-5 px-md-5">
         <div class="input-group">
  <div  id="rech"class="input-group rounded">
 
</div>

            <form>
             
            <h2 id="titre">Demander un accompte :
            <button type="button"  id="btn" class="btn btn-outline-secondary btn-fw"><a href="{{path('app_avance')}}">Ajouter</a></button>  </h2>
           
             <table class="table table-striped" id="myTable">
 
             
                      <thead>
                        <tr>
                         <th>
                         Image
                          </th>
                         <th>
                          CIN
                          </th>
                          <th>
                          Nom
                          </th>
                          <th>
                            Prenom
                          </th>
                          <th>
                           date demande
                          </th>
                          <th>
                           Montant
                          </th>
                         
                           <th> 
                           date d'avance
                          </th>
                          <th> 
                         Actions
                          </th>
                          </tr>
                      </thead>
                      <tbody>
                      {% for AvanceSalaire in salaire  %}
                     
                        <tr>
                         <td>
                         <img src="{{asset('pic/' ~ AvanceSalaire.Rh.image) }}" class="rounded-circle"
                                alt="" style="width:40px; height: 40px ">
                          </td>
                          <td>
                          {{ AvanceSalaire.Rh.cin}}
                          </td>
                             
                          <td>
                            {{ AvanceSalaire.Rh.nom}}
                          </td>
                          <td>
                          {{ AvanceSalaire.Rh.prenom}}
                          </td>
                           <td >
                         {{AvanceSalaire.datedemande|date("d/m/Y ", false)}}
                          </td>
                            <td>
                          {{ AvanceSalaire.montant}}
                          </td>
                              <td >
                         {{AvanceSalaire.dateavance|date("d/m/Y ", false)}}
                          </td>
                           <td >
                         {{AvanceSalaire.etat}}
                          </td>
                          <td><button type="button"   class="btn btn-outline-danger btn-fw"><a href="{{path('app_supprimer',{'id':AvanceSalaire.id})}}">Supprimer</a></button> 
                           <button type="button"   class="btn btn-outline-success btn-fw"><a href="{{path('app_modifavance',{'id':AvanceSalaire.id})}}">Modifier</a></button> </td>
                         <td> </td>
                        </tr >
                   
                  
                        {% endfor %}

                         
                   
                       
                      {# {{ knp_pagination_render(personne) }} #}
                        
                      </tbody>
                    </table>
             
            </form>
          </div>
        </div>
      </div>
    </div>
</center>
</form>

  
{% endblock %}

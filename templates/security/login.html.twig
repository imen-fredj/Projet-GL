{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<style>  
#page{
    
      
         margin-top:80px;
        
      }
      #login{
         margin-top:50px;
      }
 #titre{
         font-weight: bold;
      }
      #titre1{
         color:#ffa500;
          font-family: Times ;
      }
</style>
<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
 {% for message in app.flashes('error') %}
        <div class="alert alert-danger">

        
            <p>{{ message | raw }}</p>
            </div>
       
   {% endfor %}
<center>
<div class="col-lg-6 mb-5 mb-lg-0 position-relative" id="page">
        <div id="radius-shape-1" class="position-absolute rounded-circle shadow-5-strong"></div>
        <div id="radius-shape-2" class="position-absolute shadow-5-strong"></div>

        <div class="card bg-glass">
          <div class="card-body px-4 py-5 px-md-5">
            <form>
              <h1 id="titre1"> Smartup</h1>
            <h1 id="titre">Se connecter à votre compte</h1>

              <!-- Email input -->
              <div id="login" class="form-outline mb-4">
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="Adresse email">
              </div>

              <!-- Password input -->
              <div class="form-outline mb-4">
                 <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Mot de passe">
    
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
             
              </div>

              <!-- Submit button --> 
               
              <button type="submit" class="btn btn-warning btn-block mb-4"><i class="fa fa-lock"></i>
               Connexion
              </button>

              <!-- Register buttons -->
              
            </form>
          </div>
        </div>
      </div>
    </div>
</center>
</form>
{% endblock %}

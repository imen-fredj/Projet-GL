{% extends 'baseadmin.html.twig' %}

{% block title %}Ajouter un type de congé{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center font-weight-light my-2">Ajouter un nouveau type de congé</h3>
                </div>
                <div class="card-body p-4">
                    {{ form_start(for, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="form-floating mb-3">
                            {{ form_widget(for.type, {'attr': {'class': 'form-control', 'placeholder': 'Type de congé'}}) }}
                            {{ form_label(for.type, 'Type de congé') }}
                            <div class="invalid-feedback">
                                {{ form_errors(for.type) }}
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-warning btn-lg px-4">
                                <i class="fas fa-save me-2"></i>Ajouter
                            </button>
                            <a href="{{ path('app_type_conge') }}" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Annuler
                            </a>
                        </div>
                    {{ form_end(for) }}
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <div class="small">
                        <i class="fas fa-info-circle me-1"></i>
                        Ces informations seront utilisées dans la gestion des congés
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Portail RH{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <!-- Bootstrap 5 CSS only -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <!-- Google Fonts -->
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
        <style>
            :root {
                --sidebar-width: 250px;
                --sidebar-bg: #f8f9fa;
                --sidebar-color: #495057;
                --sidebar-active-bg: #e9f5ff;
                --sidebar-hover-bg: #f1f3f5;
                --topbar-height: 60px;
                --primary-blue: #2874A6;
                --dark-blue: #1F618D;
                --light-blue: #5DADE2;
                --accent-orange: #ffa500; /* Orange pour correspondre à paste-2.txt */
            }
            
            body {
                padding-left: var(--sidebar-width);
                min-height: 100vh;
                background-color: #f8f9fa;
                font-family: 'Roboto', sans-serif;
            }
            
            #sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--sidebar-bg);
                color: var(--sidebar-color);
                transition: all 0.3s;
                z-index: 1000;
                overflow-y: auto;
                box-shadow: 2px 0 10px rgba(0,0,0,0.05);
                border-right: 1px solid #e9ecef;
            }
            
            #sidebar .sidebar-header {
                padding: 20px;
                background: linear-gradient(to right, var(--primary-blue), var(--light-blue));
                border-bottom: 1px solid var(--dark-blue);
            }
            
            #sidebar .sidebar-header h4 {
                font-weight: 700;
                margin: 0;
                font-family: 'Playfair Display', serif;
                color: white;
                text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
                font-size: 25px;
            }
            
            #sidebar ul.components {
                padding: 20px 0;
            }
            
            #sidebar ul li a {
                padding: 12px 20px;
                color: var(--sidebar-color);
                display: block;
                text-decoration: none;
                transition: all 0.3s;
                font-weight: 500;
                border-left: 3px solid transparent;
            }
            
            #sidebar ul li a:hover {
                background: var(--sidebar-hover-bg);
                color: var(--dark-blue);
                border-left: 3px solid var(--accent-orange);
            }
            
            #sidebar ul li.active > a {
                background: var(--sidebar-active-bg);
                color: var(--primary-blue);
                border-left: 3px solid var(--accent-orange);
                font-weight: 600;
            }
            
            #sidebar ul li a i {
                margin-right: 10px;
                width: 20px;
                text-align: center;
                color: var(--accent-orange);
            }
            
            #sidebar ul li.active > a i {
                color: var(--primary-blue);
            }
            
            #sidebar .dropdown-toggle::after {
                display: block;
                position: absolute;
                top: 50%;
                right: 20px;
                transform: translateY(-50%);
                color: #6c757d;
            }
            
            #content {
                width: 100%;
                min-height: calc(100vh - var(--topbar-height));
                padding: 20px;
                margin-top: var(--topbar-height);
            }
            
            #topbar {
                height: var(--topbar-height);
                background: linear-gradient(to right, #F5F5F5, #F5F5F5);
                box-shadow: 0 2px 2px -2px rgba(0,0,0,.2);
                position: fixed;
                top: 0;
                right: 0;
                left: var(--sidebar-width);
                z-index: 999;
                display: flex;
                align-items: center;
                padding: 0 20px;
                color: black;
                border-bottom: 3px solid var(--primary-blue);
            }
            
            /* Boutons orange avec bordure bleue */
            .btn-orange {
                background-color: var(--accent-orange);
                color: white;
                border-color: var(--primary-blue);
            }
            
            .btn-orange:hover {
                background-color: #FFD700;
                color: var(--dark-blue);
            }
            
            /* Boutons bleus */
            .btn-blue {
                background-color: var(--primary-blue);
                color: white;
                border-color: var(--dark-blue);
            }
            
            .btn-blue:hover {
                background-color: var(--dark-blue);
                color: white;
            }
            
            /* Cards avec double couleur */
            .card-blue {
                border-top: 3px solid var(--primary-blue);
                border-left: 1px solid #e9ecef;
                border-right: 1px solid #e9ecef;
                border-bottom: 1px solid #e9ecef;
                border-radius: 6px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
                transition: transform 0.2s, box-shadow 0.2s;
            }
            
            .card-blue:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
                border-top: 3px solid var(--accent-orange);
            }
            
            .card-blue .card-header {
                background-color: rgba(40, 116, 166, 0.05);
                border-bottom: 1px solid rgba(40, 116, 166, 0.1);
                font-weight: 500;
            }
            
            /* Style de dropdown */
            .dropdown-menu {
                border: none;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                border-radius: 6px;
            }
            
            .dropdown-item:hover {
                background-color: var(--sidebar-active-bg);
                color: var(--primary-blue);
            }
            
            /* Photo de profil avec bordure bleue et orange */
            .profile-pic {
                border: 2px solid var(--primary-blue) !important;
            }
            
            .profile-pic:hover {
                border: 2px solid var(--accent-orange) !important;
            }
            
            /* Footer personnalisé */
            #footer {
                margin-top: 50px;
                background-color: #f8f9fa !important;
            }
            
            #footer h6 {
                color: var(--primary-blue);
            }
            
            /* Liens dans le footer avec couleur bleue */
            #footer a.blue-link {
                color: var(--primary-blue);
                text-decoration: none;
            }
            
            #footer a.blue-link:hover {
                color: var(--accent-orange);
                text-decoration: underline;
            }
            
            /* Badges combinant bleu et orange */
            .badge-dual {
                background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-orange) 100%);
                color: white;
            }
            
            @media (max-width: 768px) {
                body {
                    padding-left: 0;
                }
                
                #sidebar {
                    margin-left: -var(--sidebar-width);
                }
                
                #sidebar.active {
                    margin-left: 0;
                }
                
                #topbar {
                    left: 0;
                }
                
                body.active {
                    overflow: hidden;
                }
            }
        </style>
    {% endblock %}
</head>
<body>
    <!-- Sidebar -->
    <nav id="sidebar">
        <div class="sidebar-header text-center">
            <h4>Portail RH</h4>
        </div>
        
        <ul class="list-unstyled components">
            <li class="active">
                <a href="{{path('app_homeadmin')}}">
                    <i class="fas fa-home"></i> Accueil
                </a>
            </li>
            
            <li>
                <a href="#responsableSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                    <i class="fas fa-users-cog"></i> Responsable
                </a>
                <ul class="collapse list-unstyled" id="responsableSubmenu">
                    <li>
                        <a href="">Liste des responsables</a>
                    </li>
                    <li>
                        <a href="">Demandes en attente</a>
                    </li>
                </ul>
            </li>
            
            <li>
                <a href="#typesSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                    <i class="fas fa-tags"></i> Types
                </a>
                <ul class="collapse list-unstyled" id="typesSubmenu">
                    <li>
                        <a href="">Types de congés</a>
                    </li>
                    <li>
                        <a href="">Types de modification</a>
                    </li>
                    <li>
                        <a href="">Types de document</a>
                    </li>
                </ul>
            </li>
        </ul>
    </nav>

    <!-- Top Bar -->
    <nav id="topbar" class="navbar navbar-expand navbar-light">
        <div class="container-fluid">
            
            
            <div class="ms-auto d-flex align-items-center">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown">
                        <div class="position-relative me-2">
                            <img src="{{asset('pic/' ~ app.user.image) }}" 
                                 class="rounded-circle profile-pic" 
                                 width="40" height="40" 
                                 alt="Photo de profil">
                            <span class="position-absolute bottom-0 end-0 bg-success rounded-circle" style="width: 10px; height: 10px;"></span>
                        </div>
                        <span class="d-none d-md-inline fw-medium" style="color: var(--primary-blue);">{{ app.user.nom }}{{ app.user.prenom }}</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="">
                            <i class="fas fa-user-circle me-2" style="color: var(--primary-blue);"></i>Mon profil
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        {% if app.user %}
                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                            <i class="fas fa-sign-out-alt me-2"></i>Déconnexion
                        </a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div id="content">
        {% block body %}
        <!-- Contenu par défaut -->
      
        {% endblock %}
    </div>


    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        <!-- Bootstrap 5 Bundle with Popper -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://kit.fontawesome.com/7946598b52.js" crossorigin="anonymous"></script>
        
        <script>
            // Sidebar Toggle
            document.addEventListener('DOMContentLoaded', function() {
                const sidebar = document.getElementById('sidebar');
                const sidebarCollapse = document.getElementById('sidebarCollapse');
                
                sidebarCollapse.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                    document.body.classList.toggle('active');
                });
                
                // Activer les tooltips
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
                
                // Fermer les sous-menus quand un autre s'ouvre
                var dropdowns = document.querySelectorAll('.dropdown-toggle');
                dropdowns.forEach(function(dropdown) {
                    dropdown.addEventListener('click', function() {
                        var parent = this.parentElement;
                        if (parent.classList.contains('active')) {
                            return;
                        }
                        
                        // Fermer les autres dropdowns
                        dropdowns.forEach(function(otherDropdown) {
                            if (otherDropdown !== dropdown) {
                                var otherParent = otherDropdown.parentElement;
                                if (otherParent.classList.contains('active')) {
                                    var collapseId = otherDropdown.getAttribute('href');
                                    var collapseEl = document.querySelector(collapseId);
                                    if (collapseEl) {
                                        var bsCollapse = bootstrap.Collapse.getInstance(collapseEl) || new bootstrap.Collapse(collapseEl, {toggle: false});
                                        bsCollapse.hide();
                                        otherParent.classList.remove('active');
                                    }
                                }
                            }
                        });
                        
                        parent.classList.toggle('active');
                    });
                });
                
                // Effet de survol pour les liens dans le sidebar
                const sidebarLinks = document.querySelectorAll('#sidebar ul li a');
                sidebarLinks.forEach(link => {
                    link.addEventListener('mouseenter', function() {
                        this.style.transition = 'all 0.3s';
                    });
                });
                
                // Effet de survol pour les boutons
                const blueButtons = document.querySelectorAll('.btn-blue');
                blueButtons.forEach(button => {
                    button.addEventListener('mouseenter', function() {
                        this.style.transition = 'all 0.3s';
                    });
                });
                
                const orangeButtons = document.querySelectorAll('.btn-orange');
                orangeButtons.forEach(button => {
                    button.addEventListener('mouseenter', function() {
                        this.style.transition = 'all 0.3s';
                    });
                });
            });
        </script>
    {% endblock %}
</body>
</html>
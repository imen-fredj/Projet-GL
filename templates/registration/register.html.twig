{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<style>
#page{
         margin-top:80px; 
      }
      #titre{
             font-weight: bold;
      }
   #titre1{
         color:#ffa500;
          font-family: Times ;
      }
</style>
 {% for message in app.flashes('error') %}
        <div class="alert alert-danger">

        
            <p>{{ message | raw }}</p>
            </div>
       
   {% endfor %}
<center>
<div class="col-lg-6 mb-5 mb-lg-0 position-relative" id="page">
        <div id="radius-shape-1" class="position-absolute rounded-circle shadow-5-strong"></div>
        <div id="radius-shape-2" class="position-absolute shadow-5-strong"></div>

        <div class="card bg-glass">
          <div class="card-body px-4 py-5 px-md-5">
           <h1 id="titre1"> Smartup</h1>
            <h1 id="titre">Création d'un nouveau compte </h1>
          {{ form_start(registrationForm) }}
            <div id="login" class="form-outline mb-4">
              {{ form_row(registrationForm.nom) }}
              </div>
              <div  class="form-outline mb-4">
                {{ form_row(registrationForm.prenom) }}
              </div>
              <div  class="form-outline mb-4">
                  {{ form_row(registrationForm.cin) }}
              </div>
                <div id="login" class="form-outline mb-4">
              {{ form_row(registrationForm.telephone) }}
              </div>
                 <div id="login" class="form-outline mb-4">
              {{ form_row(registrationForm.image, { 'attr': {'class': ' form-control '}}) }}
              </div>
               <div class="form-outline mb-4">
                   {{ form_row(registrationForm.adresse) }}
              </div>
              <div class="form-outline mb-4">
                {{ form_row(registrationForm.roles, { 'attr': {'class': ' form-control '}}) }}
              </div>
             
              <div  class="form-outline mb-4">
                   {{ form_row(registrationForm.email) }}
              </div>
                <div class="form-outline mb-4">
               {{ form_row(registrationForm.password.first, {
            
       'attr': {'class': ' form-control ','placeholder':'Nouveau mot de passe'}}) }}
              </div>
              <div class="form-outline mb-4">
               {{ form_row(registrationForm.password.second, {
           
       'attr': {'class': ' form-control ','placeholder':'Répeter votre mot de passe'}}) }}
              </div>
            
              <button type="submit" class="btn btn-warning btn-block mb-4"  > <i class="fa fa-lock"></i>
                S'inscrire
              </button>
              {{ form_end(registrationForm) }}
          </div>
        </div>
      </div>
    </div>
</center>

{% endblock %}

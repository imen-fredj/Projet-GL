{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    {% if type == 'admin' or type == 'rh' or type == 'user'%}
    
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true, 'enctype': 'multipart/form-data'}}) }}
        <div class="mb-3">
            {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.password.first, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.password.second, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
        </div>
        
       
            <div class="mb-3">
                {{ form_row(form.prenom, {'attr': {'class': 'form-control'}}) }}
            </div>
       

        <div class="mb-3">
            {{ form_row(form.cin, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.adresse, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.telephone, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.image, {'attr': {'class': 'form-control'}}) }}
        </div>
        
        <button type="submit" class="btn btn-primary">S'inscrire</button>
    {{ form_end(form) }}
    {% endif %}
</div>
{% endblock %}
{% extends 'baserh.html.twig' %}

{% block title %}Liste des Congés{% endblock %}

{% block body %}

{% if is_granted('ROLE_Rh') %}
<style>
    .page-title {
        margin-bottom: 30px;
        font-weight: bold;
        color: #ff8c00;
        font-family: Times;
        border-bottom: 2px solid #ff8c00;
        padding-bottom: 10px;
        display: inline-block;
    }

    .search-bar {
        margin-bottom: 30px;
    }

    .table-container {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .btn-action a {
        text-decoration: none;
        color: inherit;
    }

    .btn-action:hover {
        transform: scale(1.05);
        transition: all 0.2s;
    }

    .alert-danger {
        margin-bottom: 20px;
    }

    .form-inline .form-control {
        margin-right: 10px;
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f9f9f9;
    }

    .btn-outline-success, .btn-outline-danger {
        padding: 8px 16px;
        border-radius: 5px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-outline-success:hover {
        background-color: #28a745;
        color: white;
        border-color: #28a745;
        transform: scale(1.05);
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
        border-color: #dc3545;
        transform: scale(1.05);
    }

    .btn-outline-success:focus, .btn-outline-danger:focus {
        outline: none;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
    }
    .pagination {
    display: flex;
    padding-left: 0;
    list-style: none;
    border-radius: 0.25rem;
}

.page-item:first-child .page-link {
    margin-left: 0;
    border-top-left-radius: 0.25rem;
    border-bottom-left-radius: 0.25rem;
}

.page-item:last-child .page-link {
    border-top-right-radius: 0.25rem;
    border-bottom-right-radius: 0.25rem;
}

.page-item.active .page-link {
    z-index: 1;
    color: #fff;
    background-color: #ff8c00;
    border-color: #ff8c00;
}

.page-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.75rem;
    margin-left: -1px;
    line-height: 1.25;
    color: #ff8c00;
    background-color: #fff;
    border: 1px solid #dee2e6;
}

.page-link:hover {
    color: #d17800;
    text-decoration: none;
    background-color: #e9ecef;
    border-color: #dee2e6;
}
</style>

<div class="container mt-5">
    <h2 class="page-title">Liste des Congés</h2>


    {% for message in app.flashes('notice') %}
        <div class="alert alert-danger">{{ message|raw }}</div>
    {% endfor %}

    <div class="card table-container">
        <table class="table table-striped table-hover align-middle" id="myTable">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Date Demande</th>
                    <th>Date Début</th>
                    <th>Nb Jour</th>
                    <th>Date Fin</th>
                    <th>Motif</th>
                    <th>Description</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for Conge in cong %}
                    <tr>
                        <td><img src="{{ asset('pic/' ~ Conge.Rh.image) }}" class="rounded-circle" alt="Image" width="40" height="40"></td>
                        <td>{{ Conge.Rh.nom }}</td>
                        <td>{{ Conge.Rh.prenom }}</td>
                        <td>{{ Conge.datedemande|date("d/m/Y ", false) }}</td>
                        <td>{{ Conge.datedebut|date("d/m/Y ", false) }}</td>
                        <td>{{ Conge.nbjour }}</td>
                        <td>{{ Conge.datefin|date("d/m/Y ", false) }}</td>
                        <td>{{ Conge.Typeconge.type }}</td>
                        <td>{{ Conge.description }}</td>
                        <td>{{ Conge.etat }}</td>
                        <td>
                            {% if Conge.etat == "en cours" %}
                            <div class="btn-group" role="group" aria-label="Actions sur la demande de congé">
            <a href="{{ path('accepte', {'id': Conge.id}) }}" 
               class="btn btn-success btn-sm rounded-pill me-2" 
               data-bs-toggle="tooltip" 
               title="Accepter la demande">
                <i class="fas fa-check"></i>
            </a>
                            {% endif %}
                        
                            {% if Conge.etat == "en cours" %}
                                           <div class="btn-group" role="group" aria-label="Actions sur la demande de congé">
            <a href="{{ path('refuse', {'id': Conge.id}) }}" 
               class="btn btn-danger btn-sm rounded-pill" 
               data-bs-toggle="tooltip" 
               title="Refuser la demande">
                <i class="fas fa-times"></i>
            </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
          
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        const tableRows = document.querySelectorAll('#myTable tbody tr');

        searchInput.addEventListener('keyup', function() {
            const searchValue = searchInput.value.toLowerCase();

            tableRows.forEach(row => {
                const cinCell = row.cells[1]; // CIN est dans la deuxième colonne
                const cinText = cinCell ? cinCell.textContent.toLowerCase() : '';

                if (cinText.includes(searchValue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>

{% endif %}
{% endblock %}

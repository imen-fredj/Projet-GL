{% extends 'baseEmp.html.twig' %}

{% block title %}Demande de congé{% endblock %}

{% block body %}
<style>
    .page-title {
        margin-bottom: 15px;
        font-weight: bold;
        color: #FF8C00;
        font-family: Times;
        border-bottom: 2px solid #FF8C00;
        padding-bottom: 10px;
        display: inline-block;
    }

    .form-container {
        background-color: white;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-top: 25px;
    }

    .form-control-lg {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s;
    }

    .form-control-lg:focus {
        border-color: #FF8C00;
        box-shadow: 0 0 0 0.25rem rgba(255, 140, 0, 0.25);
    }

    .btn-submit {
        background-color: #FF8C00;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-submit:hover {
        background-color: #e67e00;
        transform: translateY(-2px);
    }

    .form-label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 6px;
    }

    .bg-glass {
        background-color: rgba(255, 255, 255, 0.9) !important;
        backdrop-filter: blur(10px);
    }
    
    /* Style pour la modal de confirmation */
    .confirmation-modal .modal-header {
        background-color: #FF8C00;
        color: white;
    }
    
    .confirmation-modal .modal-footer .btn-confirm {
        background-color: #FF8C00;
        color: white;
    }
    
    .confirmation-modal .modal-footer .btn-cancel {
        border: 1px solid #FF8C00;
        color: #FF8C00;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="page-title text-center">Nouvelle demande de congé</h1>
            
            <div class="card form-container bg-glass">
    <div class="card-body">
        {{ form_start(for, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'id': 'congeForm'}}) }}
        
        <div class="row">
            <div class="col-md-6 mb-4">
                {{ form_row(for.datedebut, {
                    'attr': {
                        'class': 'form-control form-control-lg',
                        'placeholder': 'JJ/MM/AAAA'
                    }
                }) }}
            </div>
            
            <div class="col-md-6 mb-4">
                {{ form_row(for.nbjour, {
                    'attr': {
                        'class': 'form-control form-control-lg',
                        'placeholder': 'Nombre de jours'
                    }
                }) }}
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6 mb-4">
                {{ form_row(for.datefin, {
                    'attr': {
                        'class': 'form-control form-control-lg',
                        'placeholder': 'JJ/MM/AAAA'
                    }
                }) }}
            </div>
            
            <div class="col-md-6 mb-4">
                {{ form_row(for.Typeconge, {
                    'attr': {
                        'class': 'form-control form-control-lg'
                    }
                }) }}
            </div>
        </div>
        
        <div class="mb-4">
            {{ form_row(for.description, {
                'attr': {
                    'class': 'form-control form-control-lg',
                    'rows': 3,
                    'placeholder': 'Décrivez la raison de votre demande...'
                }
            }) }}
        </div>
        
        <div class="text-center mt-4">
            <button type="button" class="btn btn-submit btn-lg" data-bs-toggle="modal" data-bs-target="#confirmationModal">
                <i class="fas fa-paper-plane me-2"></i>Envoyer la demande
            </button>
        </div>
        
        {{ form_end(for) }}
    </div>
</div>
        </div>
    </div>
</div>

<!-- Modal de confirmation -->
<div class="modal fade confirmation-modal" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir soumettre cette demande de congé ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-confirm" id="confirmSubmit">Confirmer</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion de la confirmation
    document.getElementById('confirmSubmit').addEventListener('click', function() {
        // Soumettre le formulaire
        document.getElementById('congeForm').submit();
    });
    
    // Validation du formulaire avant d'afficher la modal
    document.querySelector('.btn-submit').addEventListener('click', function() {
        const form = document.getElementById('congeForm');
        if (form.checkValidity()) {
            // Si le formulaire est valide, la modal s'affiche via data-bs-toggle
        } else {
            // Si le formulaire n'est pas valide, on déclenche la validation
            form.classList.add('was-validated');
        }
    });
});
</script>
{% endblock %}
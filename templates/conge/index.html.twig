{% extends 'baseEmp.html.twig' %}

{% block title %}Demande de congé{% endblock %}

{% block body %}
<style>
    .page-title {
        margin-bottom: 30px;
        font-weight: bold;
        color: #FF8C00;
        font-family: Times;
        border-bottom: 2px solid #FF8C00;
        padding-bottom: 10px;
        display: inline-block;
    }

    .btn-add {
        background-color: #F5F5DC;
        border: 1px solid #FF8C00;
        color: #333;
        margin-left: 20px;
        transition: all 0.3s;
    }

    .btn-add:hover {
        background-color: #FF8C00;
        color: white;
    }

    .table-container {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        margin-top: 20px;
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .table img {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }

    .status-pending {
        color: #FFA500;
        font-weight: bold;
    }

    .status-approved {
        color: #28a745;
        font-weight: bold;
    }

    .status-rejected {
        color: #dc3545;
        font-weight: bold;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Demande de congé</h2>
        <a href="{{ path('app_ajoute') }}" class="btn btn-add">
            <i class="fas fa-plus me-2"></i>Ajouter une demande
        </a>
    </div>
    {% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show m-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

    <div class="card table-container">
        <table class="table table-striped table-hover align-middle" id="myTable">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>CIN</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Date demande</th>
                    <th>Date début</th>
                    <th>Nb jours</th>
                    <th>Date fin</th>
                    <th>Motif</th>
                    <th>Description</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for Conge in cong %}
                <tr>
                    <td>
                        <img src="{{ asset('pic/' ~ Conge.Rh.image) }}" class="rounded-circle" alt="Photo employé">
                    </td>
                    <td>{{ Conge.Rh.cin }}</td>
                    <td>{{ Conge.Rh.nom }}</td>
                    <td>{{ Conge.Rh.prenom }}</td>
                    <td>{{ Conge.datedemande|date("d/m/Y") }}</td>
                    <td>{{ Conge.datedebut|date("d/m/Y") }}</td>
                    <td>{{ Conge.nbjour }}</td>
                    <td>{{ Conge.datefin|date("d/m/Y") }}</td>
                    <td>{{ Conge.Typeconge.type }}</td>
                    <td>{{ Conge.description }}</td>
                    <td class="status-{{ Conge.etat|lower }}">{{ Conge.etat }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
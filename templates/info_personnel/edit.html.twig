{# edit.html.twig #}
{% extends 
    is_granted('ROLE_ADMIN') ? 'baseadmin.html.twig' : 
    is_granted('ROLE_Rh') ? 'baserh.html.twig' : 
    'baseEmp.html.twig' 
%}

{% block title %}Modifier mes informations
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-lg-10">
				<div class="card shadow-lg border-0 rounded-lg">
					<div class="card-header bg-primary text-white">
						<h3 class="text-center font-weight-light my-2">Modifier mes informations</h3>
					</div>
					<div class="card-body p-4">
						{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
						<div class="row g-4">
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
									{{ form_label(form.nom) }}
									<div class="invalid-feedback">
										{{ form_errors(form.nom) }}
									</div>
								</div>
							</div>
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
									{{ form_label(form.prenom) }}
									<div class="invalid-feedback">
										{{ form_errors(form.prenom) }}
									</div>
								</div>
							</div>
						</div>

						<div class="row g-4">
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Votre email', 'disabled': 'disabled'}}) }}
									{{ form_label(form.email) }}
									<div class="invalid-feedback">
										{{ form_errors(form.email) }}
									</div>
								</div>
							</div>
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Votre téléphone'}}) }}
									{{ form_label(form.telephone) }}
									<div class="invalid-feedback">
										{{ form_errors(form.telephone) }}
									</div>
								</div>
							</div>
						</div>

						<div class="row g-4">
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Votre adresse'}}) }}
									{{ form_label(form.adresse) }}
									<div class="invalid-feedback">
										{{ form_errors(form.adresse) }}
									</div>
								</div>
							</div>
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.cin, {'attr': {'class': 'form-control', 'placeholder': 'Votre CIN','disabled': 'disabled'}}) }}
									{{ form_label(form.cin) }}
									<div class="invalid-feedback">
										{{ form_errors(form.cin) }}
									</div>
								</div>
							</div>
						</div>

						{# Champ mot de passe #}
						<div class="row g-4">
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.password.first, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Nouveau mot de passe',
                                        'autocomplete': 'new-password'
                                    }}) }}
									{{ form_label(form.password.first, 'Nouveau mot de passe') }}
									<div class="invalid-feedback">
										{{ form_errors(form.password.first) }}
									</div>
									<small class="form-text text-muted">Laissez vide si vous ne souhaitez pas le modifier</small>
								</div>
							</div>
							<div class="col-md-6 mb-3">
								<div class="form-floating mb-3">
									{{ form_widget(form.password.second, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Confirmer le mot de passe'
                                    }}) }}
									{{ form_label(form.password.second, 'Confirmation') }}
									<div class="invalid-feedback">
										{{ form_errors(form.password.second) }}
									</div>
								</div>
							</div>
						</div>


						<div class="d-flex justify-content-center gap-3 mt-4">
						<button type="submit" class="btn btn-warning btn-lg px-4">
		<i class="fas fa-save me-2"></i>Enregistrer
	</button>

							<a href="{{ path('app_info_personnel') }}" class="btn btn-outline-secondary btn-lg px-4">
								<i class="fas fa-times me-2"></i>Annuler
							</a>
						</div>
						{{ form_end(form) }}
					</div>
					<div class="card-footer text-center py-3 bg-light">
						<div class="small">
							<i class="fas fa-info-circle me-1"></i>
							Ces informations seront utilisées dans votre profil
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

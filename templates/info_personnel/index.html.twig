{% extends 
    is_granted('ROLE_ADMIN') ? 'baseadmin.html.twig' : 
    is_granted('ROLE_Rh') ? 'baserh.html.twig' : 
    'baseEmp.html.twig' 
%}

{% block title %}Profil Personnel
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="row">
			<div class="col-lg-10 mx-auto">
				<div class="card shadow-lg border-0 rounded-lg">
					<div class="card-header bg-primary text-white">
						<h3 class="text-center font-weight-light my-2">Profil Personnel</h3>
					</div>
					<div class="card-body">
						{% for Rh in personne %}
							<div
								class="row">
								<!-- Colonne Photo et Nom -->
								<div class="col-md-4 text-center mb-4">
									<div class="profile-image-container mb-3">
										<img src="{{ asset('pic/' ~ Rh.image) }}" class="rounded-circle border shadow" alt="Photo de profil" style="width:180px; height:180px; object-fit:cover;">
										<div class="mt-3">
											<button type="button" class="btn btn-sm btn-primary position-relative shadow-sm" data-bs-toggle="modal" data-bs-target="#imageModal{{ Rh.id }}">
												<i class="fa fa-camera me-2"></i>Modifier l'image
												<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">
													<i class="fa fa-pencil-alt"></i>
													<span class="visually-hidden">Modifier</span>
												</span>
											</button>
										</div>
									</div>
									<h3 class="mb-1">{{ Rh.nom }}
										{{ Rh.prenom }}</h3>
									{% if Rh.poste is defined %}
										<p class="text-muted">{{ Rh.poste }}</p>
									{% endif %}
								</div>

								<!-- Colonne Informations -->
								<div class="col-md-8">
									<div class="card bg-light">
										<div class="card-header">
											<h5 class="mb-0">Informations personnelles</h5>
										</div>
										<div class="card-body">
											<div class="row mb-3">
												<div class="col-md-4 fw-bold text-muted">
													<i class="fa fa-envelope me-2"></i>Email:</div>
												<div class="col-md-8">{{ Rh.email }}</div>
											</div>
											<div class="row mb-3">
												<div class="col-md-4 fw-bold text-muted">
													<i class="fa fa-map-marker me-2"></i>Adresse:</div>
												<div class="col-md-8">{{ Rh.adresse }}</div>
											</div>
											<div class="row mb-3">
												<div class="col-md-4 fw-bold text-muted">
													<i class="fa fa-phone me-2"></i>Téléphone:</div>
												<div class="col-md-8">{{ Rh.telephone }}</div>
											</div>
											<div class="row mb-3">
												<div class="col-md-4 fw-bold text-muted">
													<i class="fa fa-id-card me-2"></i>CIN:</div>
												<div class="col-md-8">{{ Rh.cin }}</div>
											</div>
										</div>
									</div>

									<div class="text-center mt-4">
										<a href="{{ path('app_info_personnel_edit', {'id': Rh.id}) }}" class="btn btn-warning">
											<i class="fa fa-edit me-2"></i>Modifier le profil
										</a>
									</div>
								</div>
							</div>

							<!-- Modal de modification d'image -->
							<div class="modal fade" id="imageModal{{ Rh.id }}" tabindex="-1" aria-labelledby="imageModalLabel{{ Rh.id }}" aria-hidden="true">
								<div class="modal-dialog">
									<div class="modal-content">
										<div class="modal-header">
											<h5 class="modal-title" id="imageModalLabel{{ Rh.id }}">Modifier la photo de profil</h5>
											<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
										</div>
										<div class="modal-body">
											<form action="{{ path('update_profile_image', {'id': Rh.id}) }}" method="post" enctype="multipart/form-data">
												<div class="mb-3">
													<label for="profileImage{{ Rh.id }}" class="form-label">Choisir une nouvelle image</label>
													<input class="form-control" type="file" id="profileImage{{ Rh.id }}" name="profile_image" accept="image/*">
												</div>
												<div class="d-grid gap-2">
													<button type="submit" class="btn btn-primary">Enregistrer</button>
												</div>
											</form>
										</div>
									</div>
								</div>
							</div>

						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		.profile-image-container {
			position: relative;
			display: inline-block;
		}

		.card {
			border-radius: 15px;
			overflow: hidden;
		}

		.card-header {
			border-bottom: 1px solid rgba(0, 0, 0, 0.125);
		}

		.btn-warning {
			transition: all 0.3s ease;
			font-weight: bold;
		}

		.btn-warning:hover {
			transform: translateY(-2px);
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
		}
	</style>
{% endblock %}
